{
  "name": "openscratch",
  "version": "0.5.0",
  "private": true,
  "description": "A local open-source JavaScript, TypeScript, Python and C# playground",
  "author": "OpenScratch contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "licenses": "node scripts/licenses.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docs:dev": "vite --config website/vite.config.ts",
    "docs:build": "vite build --config website/vite.config.ts",
    "docs:preview": "vite preview --config website/vite.config.ts --host 127.0.0.1 --port 4174",
    "test:docs": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "magic-string": "^0.30.21",
    "npm": "^11.6.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.11.0",
    "marked": "18.0.14",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  },
  "build": {
    "appId": "org.openscratch.desktop",
    "afterPack": "scripts/after-pack.mjs",
    "productName": "OpenScratch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "assets/*"
    ],
    "asarUnpack": [
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**",
      "node_modules/npm/**"
    ],
    "extraResources": [
      {
        "from": "dist/types",
        "to": "types",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/METAWISER/open-scratch.git"
  },
  "homepage": "https://github.com/METAWISER/open-scratch#readme",
  "bugs": {
    "url": "https://github.com/METAWISER/open-scratch/issues"
  }
}
